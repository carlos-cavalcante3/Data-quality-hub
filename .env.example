# ---------------------------------------------------------------------------
# Data Quality Hub — variáveis de ambiente (copie para .env.local; nunca commite valores reais)
# ---------------------------------------------------------------------------

# Supabase (somente autenticação dos usuários do Hub). A anon key é pública por natureza.
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# Conexão Postgres usada pelo SERVIDOR da aplicação. A aplicação sempre executa
# "SET LOCAL ROLE hub_app" e só enxerga o schema hub. Em produção, use um usuário
# de login dedicado membro de hub_app (docs/SEGURANCA.md), via pooler (porta 6543).
DATABASE_URL=postgresql://hub_login.<ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# Somente para migrations locais (DDL). NÃO configurar na Vercel.
DATABASE_URL_ADMIN=postgresql://postgres.<ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# Administradores iniciais (separados por vírgula). Demais usuários: governance.app_users.
HUB_ADMIN_EMAILS=nome@avantia.com.br

# Login exclusivo por SSO. Provedor do Supabase Auth (Microsoft Entra ID = azure).
HUB_SSO_PROVIDER=azure

# Domínios aceitos (só pode restringir: avantia.com.br, wesafer.com, esmgroup.com.br).
HUB_ALLOWED_DOMAINS=avantia.com.br,wesafer.com,esmgroup.com.br

# Segredo do Vercel Cron (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=<gere com: openssl rand -hex 32>

# Somente desenvolvimento local: ignora o login e usa este e-mail. Ignorado em produção/Vercel.
# HUB_DEV_AUTH_BYPASS_EMAIL=nome@avantia.com.br
